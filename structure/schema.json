{
  "$defs": {
    "IntentV1": {
      "additionalProperties": false,
      "properties": {
        "object": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Object",
          "type": "string"
        }
      },
      "required": ["object"],
      "title": "IntentV1",
      "type": "object"
    },
    "PartV1": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "length_weight": {
          "anyOf": [
            {"exclusiveMinimum": 0, "maximum": 1.4142135623730951, "type": "number"},
            {"type": "null"}
          ],
          "title": "Length Weight"
        },
        "segment_index": {
          "anyOf": [
            {"maximum": 3, "minimum": 1, "type": "integer"},
            {"type": "null"}
          ],
          "title": "Segment Index"
        },
        "symmetry": {
          "anyOf": [
            {"$ref": "#/$defs/SymmetryV1"},
            {"type": "null"}
          ]
        }
      },
      "required": ["id", "name", "length_weight", "segment_index", "symmetry"],
      "title": "PartV1",
      "type": "object"
    },
    "StructureBodyV1": {
      "additionalProperties": false,
      "properties": {
        "parts": {
          "items": {"$ref": "#/$defs/PartV1"},
          "maxItems": 32,
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        }
      },
      "required": ["parts"],
      "title": "StructureBodyV1",
      "type": "object"
    },
    "SymmetryV1": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Group",
          "type": "string"
        },
        "side": {
          "enum": ["left", "right", "center"],
          "title": "Side",
          "type": "string"
        },
        "order_index": {
          "maximum": 8,
          "minimum": 1,
          "title": "Order Index",
          "type": "integer"
        }
      },
      "required": ["group", "side", "order_index"],
      "title": "SymmetryV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The LLM-facing semantic contract. Topology deliberately does not live here.",
  "properties": {
    "schema_version": {
      "const": "genori.structure.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "intent": {"$ref": "#/$defs/IntentV1"},
    "structure": {"$ref": "#/$defs/StructureBodyV1"}
  },
  "required": ["schema_version", "intent", "structure"],
  "title": "StructureV1",
  "type": "object"
}
